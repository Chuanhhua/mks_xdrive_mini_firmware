/*
  MKS XDrive Mini (STM32F405, DRV8301) motor drive firmware for the MnT Hip Exoskeleton.

  The Teensy 4.1 master commands it in torque (foc_current) mode over CAN using the
  SimpleFOC CANCommander register protocol — node address 16, 1 Mbps, 29-bit extended IDs.
  A Serial commander is also available and works with webcontroller.simplefoc.com.

  loopFOC runs at 20 kHz in a hardware timer interrupt; the motion control loop runs
  every 5 FOC loops (4 kHz).

  Safety: the current target is hard-clamped to +-CURRENT_CLAMP_A in the FOC interrupt,
  independent of anything written over CAN or Serial.
*/
#include <Arduino.h>
#include <SimpleFOC.h>
#include "current_sense/hardware_specific/stm32/stm32_adc_utils.h"

#include "comms/can/CANCommander.h"
#include "SimpleCANio.h"


// XDRIVE M0 motor pinout
#define M0_INH_A PA8
#define M0_INH_B PA9
#define M0_INH_C PA10
#define M0_INL_A PB13
#define M0_INL_B PB14
#define M0_INL_C PB15
// M0 enable pin
#define EN_GATE PB12
// M0 currents
#define M0_IB PC0
#define M0_IC PC1

// SPI pinout
#define SPI3_SCL  PC10
#define SPI3_MISO PC11
#define SPI3_MOSI PC12
#define AS5047_CS PA15
#define M0_nCS    PC13

// voltage sensing pin and scale factor
#define VSENS    PA6
#define VSCALE   19.0f // voltage divider scale factor for voltage sensing

// can communication pintout
#define CAN0_RX PB_8
#define CAN0_TX PB_9

// hard safety limit on the q-current target [A] — enforced every FOC cycle in the
// timer interrupt, so no CAN/Serial command can exceed it (7 A ≈ 27.5 Nm at the joint)
#define CURRENT_CLAMP_A 7.0f

// Motor instance
BLDCMotor motor = BLDCMotor(14);
BLDCDriver6PWM driver = BLDCDriver6PWM(M0_INH_A,M0_INL_A, M0_INH_B,M0_INL_B, M0_INH_C,M0_INL_C, EN_GATE);


// low side current sensing define
// 0.0005 Ohm resistor
// gain of 10x, 20x, 40x, 80x possible -
// we will use 80x for better low current sensing resolution (+-40A range)
// current sensing on B and C phases, phase A not connected
LowsideCurrentSense current_sense = LowsideCurrentSense(0.0005f, 80.0f, _NC, M0_IB, M0_IC);

// initialising the sensor
MagneticSensorSPI sensor = MagneticSensorSPI(AS5047_SPI, AS5047_CS, 10000000);
// SPI instance for sensor and driver configuration
SPIClass SPI_3(SPI3_MOSI, SPI3_MISO, SPI3_SCL);

// instantiate the serial commander
Commander command = Commander(Serial);
void doMotor(char* cmd) { command.motor(&motor, cmd); }

// CAN commander — node address 16
CANio can(CAN0_RX, CAN0_TX);
CANCommander commandc(can, 16);


// DRV8301 SPI access — 16-bit frames: bit15 R/W (1=read), bits[14:11] register, bits[10:0] data.
// SPI mode 1. Registers only respond while EN_GATE is high, and a low EN_GATE resets them to
// defaults, so gain configuration must happen after the driver is enabled (motor.init()).
uint16_t drv8301_transfer(uint16_t word) {
  SPI_3.beginTransaction(SPISettings(1000000, MSBFIRST, SPI_MODE1));
  digitalWrite(M0_nCS, LOW);
  uint16_t rx = SPI_3.transfer16(word);
  digitalWrite(M0_nCS, HIGH);
  SPI_3.endTransaction();
  return rx;
}

// Set the current sense amplifier gain to 80 V/V: Control Register 2 (0x03), GAIN bits [3:2] = 0b11.
// Returns true when the read-back confirms it — on false the 80x assumed by LowsideCurrentSense
// does not match the hardware and all currents/torques are scaled wrong.
// Read-back values: 0x180C = gain 80 confirmed (addr echo + data); 0x0000 = write ignored;
// 0x7FF/0xFFFF = MISO floating — no DRV8301 responding on SPI.
bool drv8301_set_gain_80() {
  drv8301_transfer((0x03 << 11) | 0x0C);                      // write CTRL2: gain 80
  drv8301_transfer((1 << 15) | (0x03 << 11));                 // request CTRL2 read
  uint16_t ctrl2 = drv8301_transfer((1 << 15) | (0x03 << 11)); // response arrives one frame later
  Serial.print("DRV8301 CTRL2 read-back: 0x");
  Serial.println(ctrl2, HEX);
  // exact match required: frame-fault bit clear and data exactly what we wrote,
  // so a floating/stuck MISO can not pass as success
  return (ctrl2 & 0x8000) == 0 && (ctrl2 & 0x7FF) == 0x0C;
}


void setup(){
  // short grace period to open a serial monitor for the boot log (debug only)
  _delay(1000);
  // use monitoring with serial
  Serial.begin(115200);
  // enable more verbose output for debugging
  // comment out if not needed
  SimpleFOCDebug::enable(&Serial);

  pinMode(VSENS, INPUT_ANALOG);
  float v = _readRegularADCVoltage(VSENS)*VSCALE;
  SIMPLEFOC_DEBUG(" V sens: ", v);

  // DRV8301 chip select — idle high; gain is configured after motor.init() (EN_GATE must be high)
  pinMode(M0_nCS, OUTPUT);
  digitalWrite(M0_nCS, HIGH);
  SPI_3.begin();

  // power supply voltage [V]
  driver.voltage_power_supply = v;
  // Max DC voltage allowed - default voltage_power_supply
  driver.voltage_limit = v;
  driver.dead_zone = 0.001f;
  // driver init
  driver.init();
  // link the motor and the driver
  motor.linkDriver(&driver);

  // initialize encoder sensor hardware
  sensor.init(&SPI_3);
  // link the motor to the sensor
  motor.linkSensor(&sensor);
  
  // control loop type and torque mode 
  motor.torque_controller = TorqueControlType::foc_current;
  motor.controller = MotionControlType::torque;

  // max voltage  allowed for motion control
  motor.voltage_limit = 30.0;
  // alignment voltage limit
  motor.voltage_sensor_align = 5.0;
  // current limit for the velocity/angle cascades; note that in pure torque mode
  // SimpleFOC does NOT apply it to the target — that is what the interrupt clamp is for
  motor.current_limit = CURRENT_CLAMP_A;
  
  // comment out if not needed
  motor.useMonitoring(Serial);
  // setup monitoring for webcontroller.simplefoc.com
  motor.monitor_end_char = 'M'; // set monitoring end character to M 
  motor.monitor_start_char = 'M'; // set monitoring start character 
  // add target command T
  command.add('M', doMotor, "motor M0");
  motor.monitor_downsample = 0; // disable at start

  // instantiate the CAN commander
  commandc.init();
  commandc.addMotor(&motor);

  // initialise motor
  motor.init();

  // configure the drv8301 gain to 80 for better low current sensing resolution (+-41A range).
  // must run after motor.init(): EN_GATE is high now, and a low EN_GATE resets the DRV8301 registers.
  // must run before current_sense.init() so offset calibration sees the final gain.
  if (drv8301_set_gain_80()) {
    SIMPLEFOC_DEBUG("DRV8301: gain 80 confirmed");
  } else {
    SIMPLEFOC_DEBUG("DRV8301: gain config FAILED - currents/torques will be 8x too high!");
  }

  // link the driver
  current_sense.linkDriver(&driver);
  // init the current sense
  current_sense.init();  
  current_sense.skip_align = true;
  motor.linkCurrentSense(&current_sense);

  // init FOC  
  motor.initFOC();  

  motor.characteriseMotor(1.0f); // characterise motor with 1.0V
  motor.tuneCurrentController(100.0f);
  delay(1000);

  
  motor.motion_downsample = 5; // run motion control every 5 FOC loops (4 kHz)
  // run the FOC loop in a 20 kHz hardware timer interrupt
  HardwareTimer* timer = new HardwareTimer(TIM8);
  timer->setOverflow(20000, HERTZ_FORMAT);
  timer->attachInterrupt([](){
    // hard safety clamp — applied every cycle so no CAN/Serial write can exceed it
    if (motor.controller == MotionControlType::torque)
      motor.target = _constrain(motor.target, -CURRENT_CLAMP_A, CURRENT_CLAMP_A);
    motor.loopFOC();
    motor.move();
  });
  // start the timer
  timer->resume();
}


void loop(){
  // monitoring
  motor.monitor();
  // user communication
  command.run();
  // CAN communication
  commandc.run();
}
